{
	"name": "satisfier",
	"version": "5.4.5",
	"description": "A purposely loose comparison tool.",
	"homepage": "https://github.com/cyberuni/satisfier",
	"bugs": {
		"url": "https://github.com/cyberuni/satisfier/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/satisfier.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"import": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"require": {
			"types": "./cjs/index.d.ts",
			"default": "./cjs/index.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!ts/testPredicates.ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*"
	],
	"scripts": {
		"build": "tsdown",
		"build:doc": "typedoc --plugin typedoc-plugin-extras",
		"check": "biome check",
		"check:fix": "biome check --write",
		"clean": "rimraf cjs coverage docs esm lib tslib *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"cs": "changeset",
		"knip": "knip",
		"dev": "vitest",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"nuke": "pnpm clean && rimraf node_modules .turbo",
		"prepare": "husky",
		"release": "changeset publish",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"verify": "biome ci . && turbo run build typecheck coverage knip size",
		"version": "changeset version"
	},
	"dependencies": {
		"tersify": "^4.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"@size-limit/preset-small-lib": "^13.0.3",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.6.0",
		"husky": "^9.1.7",
		"knip": "^6.33.0",
		"rimraf": "^6.1.3",
		"size-limit": "^13.0.3",
		"tsdown": "^0.22.14",
		"turbo": "^2.10.12",
		"type-plus": "8.0.0-beta.10",
		"typedoc": "^0.28.20",
		"typedoc-plugin-extras": "^4.0.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.25.0"
}
